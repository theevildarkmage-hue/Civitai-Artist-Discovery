# SERVER/EDGE ONLY. Never distribute these values in Discovery.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_EDGE_SECRET_STORE_ONLY
# Fail closed until staging and rollout are explicitly approved.
COMMUNITY_BETA_STATE=disabled
COMMUNITY_ALLOWED_RATINGS=1,2
# Identity-only candidate: independent random 32-byte base64url HMAC key.
# Provision through secure owner custody and the hosted secret store, not a file.
DISCOVERY_IDENTITY_CHALLENGE_KEY=REPLACE_IN_EDGE_SECRET_STORE_ONLY
# Artwork verification is anonymous; no Civitai metadata API key is required.
# Desktop configuration has no privileged secret:
# CAD_COMMUNITY_MODE=supabase
# CAD_COMMUNITY_URL=https://PROJECT_REF.supabase.co/functions/v1/community-v1
