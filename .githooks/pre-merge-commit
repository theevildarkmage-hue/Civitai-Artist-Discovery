#!/bin/sh
set -eu
guard_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python "$guard_root/scripts/check-git-identity.py" --effective
if git rev-parse --verify MERGE_HEAD >/dev/null 2>&1; then
  exec python "$guard_root/scripts/check-git-identity.py" --tip "$(git rev-parse MERGE_HEAD)" --before "$(git rev-parse HEAD)"
fi
