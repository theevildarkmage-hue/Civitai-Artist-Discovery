# Public-source allowlist
#
# This repository is developed beside large local archives and account-derived runtime
# data. Ignore everything by default and explicitly admit only the files required to
# understand, run, test, and reproduce the application. New source categories must be
# reviewed and added deliberately.
*

# Repository entry points
!.gitignore
!README.md
!AGENTS.md
!CONTRIBUTING.md
!LICENSE
!THIRD_PARTY_NOTICES.md
!requirements-dev.txt
!requirements.txt
!server.py

# Portable runtime data lives beside the executable/source checkout.
data/

# Application modules
!discovery/
discovery/*
!discovery/*.py

# Browser application (the build regenerates static/app.ico)
!static/
static/*
!static/*.html
!static/*.js
!static/*.css

# Reproducible launch/build utilities
!scripts/
scripts/*
!scripts/*.py
!scripts/*.ps1

# Existing standalone validation suite
!tests/
tests/*
!tests/*.py
!tests/*.mjs

# Current behavioral documentation and the active release notes only. Historical audits
# and superseded release plans remain local.
!docs/
docs/*
!docs/content-controls.md
!docs/beta-release.md
!docs/release-notes.md
!docs/updates.md
!docs/time-machine-spec.md
!docs/2.0-project-plan.md
!docs/2.0-progress.md
!docs/2.0-checkpoint.md
!docs/2.0-testing.md
!docs/video-cards.md
# Internal ToS working notes. Never whitelist this: it is a candid self-assessment,
# including open questions, and is not written to be read as a public claim.
docs/tos-compliance.md

# Shared v2 browser modules and design system
!static/ui/
!static/ui/*.js
!static/styles/
!static/styles/*.css

# Reports are generated locally and are never published.
reports/

# Release artwork, article drafts, and screenshots are published on Civitai, not here.
assets/
release-assets/

# Local server logs from development runs; CONTRIBUTING forbids committing logs.
logs/

# Discovery 3.0 source artifacts only; runtime and secrets remain excluded.
.data-directory-3.0.json
!docs/3.0-*.md
!supabase/
!supabase/**/
!supabase/**/*.sql
!supabase/**/*.ts
!supabase/config.toml
!supabase/.env.example

# Reviewed offline video/browser fixtures and availability contract.
!tests/fixtures/
!tests/fixtures/recovery.mp4
!tests/fixtures/video_lifecycle.mjs
!docs/artwork-availability.txt

# Defense in depth after source allowlists: runtime and sensitive artifacts stay local.
**/__pycache__/
**/*.pyc
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.dpapi
**/*.log
**/*.jsonl
**/.env
**/.env.*
!supabase/.env.example
data-*/
data_*/
.venv*/
.data-directory-3.0.json

# Local commit gate; install explicitly with the documented local Git configuration.
!.githooks/
!.githooks/pre-commit

# Removable, unpackaged Community Test Lab. Public metadata only; no keys/state.
!dev/
dev/*
!dev/community-test-lab/
dev/community-test-lab/*
!dev/community-test-lab/*.py
!dev/community-test-lab/*.js
!dev/community-test-lab/*.css
!dev/community-test-lab/README.md
!dev/community-test-lab/public-fixtures.json
